# ==============================================================================
# 🚢 SIH26006 Maritime Freight Forecasting - Comprehensive .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Python Bytecode, C-Extensions & Compilation Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.dylib
*.dll
*.pyd
*.c
*.html.coverage

# ------------------------------------------------------------------------------
# 2. Virtual Environments, Package Managers & Distributions
# ------------------------------------------------------------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
.conda/
pip-log.txt
pip-delete-this-directory.txt
pip-wheel-metadata/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
build/
dist/
develop-eggs/
.eggs/
parts/
var/
sdist/
.python-version

# ------------------------------------------------------------------------------
# 3. Environment Variables, Secrets & API Keys (CRITICAL FOR SECURITY)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.keystore
credentials.json
client_secret*.json
service_account*.json
secrets.toml
secrets/
.aws/
.azure/
.gcloud/

# ------------------------------------------------------------------------------
# 4. Machine Learning, Deep Learning & Experiment Tracking
# ------------------------------------------------------------------------------
# Checkpoints, temporary weights & temporary model dumps
*.pt.tmp
*.pth.tmp
*.ckpt
*.h5.tmp
*.joblib.tmp
checkpoints/
runs/
tensorboard/
events.out.tfevents.*

# Experiment tracking & model registries
wandb/
mlruns/
.mlflow/
ray_results/
.dvc/cache/

# Model, tokenizer & data caches
.cache/
data_cache/
models_cache/
.huggingface/
hf_cache/

# Large compressed archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# ------------------------------------------------------------------------------
# 5. Jupyter Notebooks & Data Science Checkpoints
# ------------------------------------------------------------------------------
.ipynb_checkpoints
*/.ipynb_checkpoints/*
*-checkpoint.ipynb
.virtual_documents/

# ------------------------------------------------------------------------------
# 6. Testing, Quality & Profiling Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage/
.tox/
.nox/
coverage.xml
nosetests.xml
htmlcov/
*.cover
*.py,cover
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
*.prof
*.pstats
playwright-report/
test-results/
cypress/videos/
cypress/screenshots/

# ------------------------------------------------------------------------------
# 7. Database, Server, Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db3
dump.rdb
*.pid
*.seed
celerybeat-schedule
celerybeat.pid
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*.swo
*~

# ------------------------------------------------------------------------------
# 8. Web & Frontend Frameworks (React / Next.js / Vite / Vue / Node / Bun)
# ------------------------------------------------------------------------------
node_modules/
.npm/
.next/
out/
dist-ssr/
.parcel-cache/
.turbo/
.svelte-kit/
.nuxt/
.output/
.docusaurus/
.eslintcache
.stylelintcache
*.tsbuildinfo
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/
.streamlit/secrets.toml
.streamlit/credentials.toml

# ------------------------------------------------------------------------------
# 9. IDEs, Code Editors & Workspaces
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.project
.pydevproject
.settings/
*.code-workspace

# ------------------------------------------------------------------------------
# 10. AI Coding Assistants & Agent Caches
# ------------------------------------------------------------------------------
.cursor/
.windsurf/
.claude/
.gemini/
.agents/
.copilot/

# ------------------------------------------------------------------------------
# 11. Operating System Specific Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
.directory
.fuse_hidden*
.nfs*
